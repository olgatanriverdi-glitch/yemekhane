rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Puanlar: her kullanıcı bir öğün için tek puan verebilir (belge kimliği = slot_kullanıcıId); herkes okuyabilir.
    match /ratings/{id} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'slot', 'stars', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.slot + '_' + request.auth.uid
        && request.resource.data.slot is string && request.resource.data.slot.size() < 80
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1 && request.resource.data.stars <= 5;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Yorumlar: herkes okur; giriş yapmış (anonim dahil) herkes yazar; yalnızca sahibi siler.
    match /comments/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'slot', 'name', 'text', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.slot is string && request.resource.data.slot.size() < 80
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 24
        && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 300
        && request.resource.data.createdAt is timestamp;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Yorum bildirimleri (Google Play kullanıcı içeriği politikası): giriş yapmış herkes yalnızca geçerli alanlarla
    // OLUŞTURABİLİR; uygulama bildirimleri okuyamaz, değiştiremez, silemez. Bildirimleri yalnızca proje sahibi
    // Firebase konsolundan görür (konsol kuralları atlar).
    match /reports/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'commentId', 'slot', 'reason', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'commentId', 'reason', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.commentId is string
        && request.resource.data.commentId.size() >= 1 && request.resource.data.commentId.size() <= 64
        && request.resource.data.slot is string && request.resource.data.slot.size() <= 80
        && request.resource.data.reason in ['hakaret', 'spam', 'uygunsuz', 'diger']
        && request.resource.data.createdAt is timestamp;
      allow read, update, delete: if false;
    }
  }
}
